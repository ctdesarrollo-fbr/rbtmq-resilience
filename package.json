{
  "name": "rbtmq-resilience",
  "version": "1.0.0",
  "description": "RabbitMQ resilience for ts services.",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./domain/dtos/eventManager": {
      "types": "./dist/shared/dtos/eventManager.d.ts",
      "import": "./dist/shared/dtos/eventManager.mjs",
      "require": "./dist/shared/dtos/eventManager.cjs"
    }
  },
  "author": "xKewlis",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun build ./src/index.ts ./src/shared/dtos/eventManager.ts --outdir ./dist --target node --packages external --format esm --entry-naming [dir]/[name].mjs && bun build ./src/index.ts ./src/shared/dtos/eventManager.ts --outdir ./dist --target node --packages external --format cjs --entry-naming [dir]/[name].cjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bun": "^1.4.4",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "amqplib": "^2.2.1",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6"
  }
}