exports[`database the migration SQL is unchanged 1`] = `
"
CREATE TABLE IF NOT EXISTS inbox (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  message_id VARCHAR(191) NOT NULL,
  handler_name VARCHAR(191) NOT NULL,
  payload JSON NOT NULL,
  processed_at TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_inbox_message_id (message_id),
  UNIQUE KEY uq_inbox_message_handler (message_id, handler_name)
);

CREATE TABLE IF NOT EXISTS outbox (
  id INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
  message_id VARCHAR(191) NOT NULL,
  type VARCHAR(191) NOT NULL,
  headers JSON NOT NULL,
  body JSON NOT NULL,
  exchange VARCHAR(191) NOT NULL,
  routing_key VARCHAR(191) NOT NULL,
  status VARCHAR(16) NOT NULL DEFAULT 'sent',
  attempts INT NOT NULL DEFAULT 1,
  error TEXT NULL,
  sent_at TIMESTAMP NULL,
  failed_at TIMESTAMP NULL,
  created_at TIMESTAMP NULL DEFAULT CURRENT_TIMESTAMP,
  UNIQUE KEY uq_outbox_message_id (message_id)
);
"
`;
